{
  "name": "Dibodev Admin",
  "short_name": "Dibodev",
  "description": "Back-office de dibodev.fr : articles, traductions, Search Console, indexation et audits.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/dashboard",
  "display": "standalone",
  "orientation": "any",
